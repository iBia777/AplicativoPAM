<?xml version="1.0" encoding="utf-8"?>
<!--
    EXERCÍCIO 05 - Tela de aplicativo (3 níveis de aninhamento)
    Conceito: vertical > horizontal > vertical > horizontal, usando apenas
              alturas/larguras fixas e match_parent.
    Repare que sobra espaço em branco no fim da tela: sem layout_weight não
    dá para esticar o conteúdo até o rodapé.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- NÍVEL 1: TOPO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#1E88E5"
        android:gravity="center"
        android:text="TOPO"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- NÍVEL 2: CORPO (horizontal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:orientation="horizontal">

        <!-- NÍVEL 3: coluna da ESQUERDA, largura fixa -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="#E53935"
                android:gravity="center"
                android:text="E1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="#FB8C00"
                android:gravity="center"
                android:text="E2"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="#FDD835"
                android:gravity="center"
                android:text="E3"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NÍVEL 3: coluna da DIREITA, ocupa o espaço que sobrou -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="#43A047"
                android:gravity="center"
                android:text="D1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- NÍVEL 4: linha dentro da coluna da direita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="#8E24AA"
                    android:gravity="center"
                    android:text="D2"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#00ACC1"
                    android:gravity="center"
                    android:text="D3"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- NÍVEL 1: MENU (centralizado com gravity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="#546E7A"
            android:gravity="center"
            android:text="M1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="#37474F"
            android:gravity="center"
            android:text="M2"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="#546E7A"
            android:gravity="center"
            android:text="M3"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
